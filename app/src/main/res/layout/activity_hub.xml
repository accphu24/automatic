<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/hub_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHubRefresh"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hub_refresh" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvHubStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textSize="12sp"
        tools:text="Cập nhật lúc 22:45:48 · tự làm mới mỗi 30 giây" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <include
                android:id="@+id/secHuntbot"
                layout="@layout/item_hub_section" />

            <include
                android:id="@+id/secGems"
                layout="@layout/item_hub_section" />

            <include
                android:id="@+id/secQuest"
                layout="@layout/item_hub_section" />

            <include
                android:id="@+id/secTeam"
                layout="@layout/item_hub_section" />

            <include
                android:id="@+id/secBattles"
                layout="@layout/item_hub_section" />

            <include
                android:id="@+id/secZoo"
                layout="@layout/item_hub_section" />

            <include
                android:id="@+id/secWeapons"
                layout="@layout/item_hub_section" />

            <include
                android:id="@+id/secInventory"
                layout="@layout/item_hub_section" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
