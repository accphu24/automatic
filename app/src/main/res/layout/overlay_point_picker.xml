<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvPickerPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#CC212121"
        android:gravity="center"
        android:padding="14dp"
        android:text="Chạm vào điểm bắt đầu"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/pickerMarkerStart"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_marker_start"
        android:visibility="gone" />

    <View
        android:id="@+id/pickerMarkerEnd"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_gravity="top|start"
        android:background="@drawable/bg_marker_end"
        android:visibility="gone" />

</FrameLayout>
